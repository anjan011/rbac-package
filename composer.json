{
    "name": "anjan011/roles-and-permissions",
    "description": "A simple and easy-to-use way to manage roles and permissions in Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anjan",
            "email": "anjan@example.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Anjan011\\RolesAndPermissions\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anjan011\\RolesAndPermissions\\RolesAndPermissionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan anjan011-roles-permissions:setup-instructions --ansi"
        ]
    }
}
